# Copie para .env (ou defina no ambiente do servidor) antes de publicar.

# Chave usada para assinar o cookie de sessão. Gere uma só sua com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Em produção, faz o cookie de sessão exigir HTTPS.
ENV=production

# Token da API da Acessórias (gerado dentro do Acessórias, no ícone de
# engrenagem → "API Token"). Sem isso, o portal mostra as seções que
# dependem dela vazias, mas continua funcionando.
ACESSORIAS_API_TOKEN=

# --- E-mail ("Esqueceu sua senha?" / primeiro acesso por e-mail) ---------
# Caixa da Facchini na Locaweb, SMTP com SSL direto. Sem
# SMTP_USUARIO/SMTP_SENHA o portal continua mostrando a mesma mensagem
# neutra ao cliente, mas nenhum e-mail sai (fica um aviso no log).
# Vazio = padrão: email-ssl.com.br
SMTP_HOST=
# Vazio = padrão: 465 (SSL)
SMTP_PORT=
# Endereço completo da caixa que autentica no SMTP (ex.: a de notificação).
SMTP_USUARIO=
# Senha dessa caixa — só no ambiente do servidor, nunca no código.
SMTP_SENHA=
# Remetente que aparece pro cliente (normalmente a mesma caixa acima).
# Vazio = padrão: notificacao@facchiniassessoria.com.br
EMAIL_REMETENTE=
# Base dos links mandados por e-mail. Fixa aqui de propósito: o link nunca
# é montado a partir do endereço que veio na requisição.
# Vazio = padrão: https://portal.facchiniassessoria.com.br
URL_PORTAL=
# Só para desenvolvimento local com um servidor SMTP falso (sem TLS):
# SMTP_SSL=0. Ignorado quando ENV=production.
# SMTP_SSL=0
